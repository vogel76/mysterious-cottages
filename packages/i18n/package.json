{
  "name": "@chatynkowo/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chatynkowo interface dictionaries (pl, en): the shared set at the package root, the site-only set under ./web and the app-only set under ./mobile, each with its i18next resources. No i18next initialisation: each app wires them up itself.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    },
    "./mobile": {
      "types": "./src/mobile/index.ts",
      "default": "./src/mobile/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chatynkowo/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
