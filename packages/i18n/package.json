{
  "name": "@chatynkowo/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chatynkowo interface dictionaries (pl, en), shared by the web and the mobile app. No i18next initialisation: each app wires them up itself.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chatynkowo/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
