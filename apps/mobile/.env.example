# Copy to .env (ignored by git). Without the file the app falls back to the
# defaults in src/config.ts: the public Chatynkowo Supabase project and the
# published site as the content origin. The sign-in setup is described in
# supabase/README.md ("Sign-in providers"); changing the sign-in variables
# is followed by a native rebuild.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where data/, cottages/ and assets/ are served from.
EXPO_PUBLIC_CONTENT_BASE_URL=
# OAuth client ids of the backend's Google provider (Google Cloud, the
# project behind the site's sign-in): the web client, whose tokens the
# native flow mints, and the iOS client. The Google button appears once the
# web id is set (on iOS once both are); the Android client is registered in
# the same project by package name and signing SHA-1 and needs nothing here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# "0" leaves Sign in with Apple out of the build (a free Personal Team cannot
# sign the capability); unset for store builds, which must carry it.
EXPO_PUBLIC_APPLE_SIGN_IN=
# The app's Apple team: it signs device builds (expo run:ios --device) and
# owns the Sign in with Apple key, which supabase/apple-sign-in.mjs reads
# from here rather than asking again.
APPLE_TEAM_ID=
