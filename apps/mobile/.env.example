# Copy to .env (ignored by git). Without the file the app falls back to the
# defaults in src/config.ts: the public Chatynkowo Supabase project and the
# published site as the content origin.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where data/, cottages/ and assets/ are served from.
EXPO_PUBLIC_CONTENT_BASE_URL=
# "true" once Google and Apple sign-in are configured in the backend.
EXPO_PUBLIC_AUTH_ENABLED=
# OAuth web client id of the Supabase Google provider (native Google sign-in).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
