{
  "name": "chatynkowo",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter @chatynkowo/web dev",
    "build": "pnpm --filter @chatynkowo/web build",
    "preview": "pnpm --filter @chatynkowo/web preview",
    "check": "pnpm -r run check && node scripts/check-conventions.mjs",
    "icons:build": "pnpm --filter @chatynkowo/web icons:build",
    "codes:build": "pnpm --filter @chatynkowo/content codes:build",
    "codes:check": "pnpm --filter @chatynkowo/content codes:check",
    "auth:apple": "node supabase/apple-sign-in.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "typescript": "~5.9.3"
  }
}
