# Copy to .env (ignored by git) and run `pnpm auth:apple` to switch on Sign
# in with Apple in the linked project (supabase/apple-sign-in.mjs). The
# Apple team and the app's bundle id are not repeated here: the script
# reads them from the app's configuration (apps/mobile/.env, app.json).
# The Google provider is set in the dashboard, as README.md describes.
# A personal access token (supabase.com/dashboard/account/tokens); the
# same variable the Supabase CLI reads.
SUPABASE_ACCESS_TOKEN=
# The Sign in with Apple key: its id and the downloaded .p8 (path relative
# to this directory; .p8 files are ignored by git), and the Services ID of
# the site.
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APPLE_SERVICES_ID=
